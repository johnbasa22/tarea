<!doctype html>
<html lang="es" data-bs-theme="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>johan Batista — Frontend Developer & UI/UX Designer | Portafolio</title>
  <meta name="description" content="Portafolio profesional ciberpunk oscuro de Johan Batista: Frontend Developer & UI/UX Designer. Proyectos web, apps, diseño y videos destacados." />
  <meta name="theme-color" content="#05060a" />

  <!-- Bootstrap 5 -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

  <!-- Font Awesome -->
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet">

  <style>
    :root{
      --bg-0:#05060a;
      --bg-1:#0a0f1f;
      --card:#0b1022cc;
      --card-2:#0b1022f2;
      --text:#eaf3ff;
      --muted:#a8b7d6;
      --border: rgba(122, 209, 255, .28);
      --border-2: rgba(255, 214, 102, .22);
      --neon-blue:#66d3ff;
      --neon-cyan:#3fffd7;
      --neon-yellow:#ffd666;
      --neon-green:#3cff7a;
      --shadow: 0 20px 60px rgba(0,0,0,.45);
      --focus: rgba(102, 211, 255, .45);
      --btn:#2f8cff;
      --btn2:#1ea6ff;
      --soft: rgba(102, 211, 255, .10);
      --soft2: rgba(63, 255, 215, .10);
      --radius: 18px;
      --glass: blur(10px);
    }

    /* Light mode tokens */
    html[data-bs-theme="light"]{
      --bg-0:#f6f8ff;
      --bg-1:#eaf1ff;
      --card: rgba(255,255,255,.72);
      --card-2: rgba(255,255,255,.92);
      --text:#061225;
      --muted:#223556;
      --border: rgba(26, 154, 255, .22);
      --border-2: rgba(255, 193, 57, .25);
      --shadow: 0 20px 60px rgba(8, 18, 45, .18);
      --focus: rgba(26, 154, 255, .40);
      --btn:#176bff;
      --btn2:#0b5dff;
      --soft: rgba(23, 107, 255, .12);
      --soft2: rgba(0, 221, 182, .12);
    }

    body{
      background:
        radial-gradient(1200px 600px at 10% -10%, rgba(102,211,255,.18), transparent 60%),
        radial-gradient(900px 450px at 90% 10%, rgba(255,214,102,.12), transparent 55%),
        radial-gradient(900px 450px at 20% 90%, rgba(63,255,215,.10), transparent 55%),
        linear-gradient(180deg, var(--bg-0), var(--bg-1));
      color: var(--text);
      overflow-x: hidden;
    }

    .matrix-canvas{
      position: fixed;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: -1;
      opacity: 1;
      pointer-events: none;
    }

    .section{
      padding: 72px 0;
    }
